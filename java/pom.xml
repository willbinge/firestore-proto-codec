<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.codebinge</groupId>
  <artifactId>firestore-proto-codec</artifactId>
  <version>0.1.0-SNAPSHOT</version>

  <name>firestore-proto-codec</name>
  <description>Encode a protobuf message as a Firestore value, and decode it back.</description>
  <url>https://github.com/willbinge/firestore-proto-codec</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Code Binge LLC</name>
      <url>https://github.com/willbinge</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/willbinge/firestore-proto-codec.git</connection>
    <developerConnection>scm:git:git@github.com:willbinge/firestore-proto-codec.git</developerConnection>
    <url>https://github.com/willbinge/firestore-proto-codec</url>
  </scm>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Must match the protoc that produced src/**/generated code. protobuf 4.x
         gencode refuses to load against an older runtime, and that is a
         class-load failure rather than a compile error; see ProtoGencodeTest. -->
    <protobuf.version>4.33.3</protobuf.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>${protobuf.version}</version>
    </dependency>

    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java-util</artifactId>
      <version>${protobuf.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Everything Maven Central requires beyond the ordinary build: sources
         and javadoc jars, GPG signatures, and the Central Portal uploader.
         Kept in a profile so `mvn test` and CI stay fast and need no GPG key.

         Release with:  mvn -Prelease deploy
         See RELEASING.md for the one-time account, namespace and key setup. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
            <configuration>
              <!-- The generated protobuf sources carry no javadoc, and doclint
                   would turn "no comment" on every generated accessor into a
                   release-blocking error. Warnings on hand-written code still
                   show; they just do not fail the build. -->
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
            <!-- No <gpgArguments> on purpose. The passphrase comes from
                 gpg-agent, which prompts through pinentry once and caches it,
                 so it never appears in a command line, a property or this file.

                 Do NOT add `--pinentry-mode loopback` here: loopback means gpg
                 takes the passphrase from the calling program rather than the
                 agent, and Maven supplies none, so signing fails with
                 "No pinentry". Loopback is the CI configuration, where it is
                 paired with a passphrase piped from a secret:

                   mvn -Prelease deploy \
                     -Dgpg.passphraseServerId=gpg -Dgpg.pinentry-mode=loopback

                 Local releases need a pinentry gpg-agent can actually reach
                 from a non-interactive build; see RELEASING.md. -->
          </plugin>

          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <!-- Credentials come from the <server> with this id in
                   ~/.m2/settings.xml; never from this file. -->
              <publishingServerId>central</publishingServerId>
              <!-- Upload and validate, but leave the final release to a human
                   in the Central Portal UI. Set to true once the first release
                   has gone through cleanly. -->
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
